      "product_name": "Paperless Banking",
      "intended_use": "Switch statements to digital",
      "indicative_criteria": "Receives paper statements (not a credit decision)",
      "sustainability_metric": "kg paper/yr, statements avoided",
      "credit_product": false,
      "applicable_exclusions": [
        "EXC_AGE_RESTRICTION",
        "EXC_ALREADY_PAPERLESS",
        "EXC_COMPLIANCE_HOLD",
        "EXC_DUPLICATE_OFFER",
        "EXC_INACTIVE_ACCOUNT",
        "EXC_NO_DIGITAL_CHANNEL",
