            },
            "annual_mileage_km": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Kilometres per year (NOT miles)"
            },
            "baseline_electricity_kwh": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
