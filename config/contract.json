        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impact": {
          "type": [
            "object",
            "null"
          ],
          "description": "Carbon engine ImpactResult (see docs/carbon_methodology.md); null in exclusion-engine output"
        },
        "grounded_attributes": {
          "type": "object",
          "required": [
            "data_cutoff_date"
          ],
          "description": "Observed inputs only. No modelled numbers (carbon comes from the carbon engine via impact)",
