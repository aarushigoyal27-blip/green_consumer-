            },
            "baseline_gas_kwh": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "kWh per year (gross CV), annualised from available months"
            },
            "paper_statements_per_year": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "property_epc_rating": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E",
                "F",
                "G",
                null
              ]
            },
            "property_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "DETACHED",
                "SEMI_DETACHED",
