                "BUNGALOW",
                "FLAT",
                "APARTMENT",
                "MAISONETTE_SHARED",
                "COMMUNAL",
                null
              ]
            },
            "vehicle_fuel_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "petrol",
                "diesel",
                "hybrid",
                "ev",
                null
              ],
              "description": "Primary vehicle; carbon engine input"
            }
          }
        }
      }
    },
    "customer_multi_product_response": {
      "title": "CustomerMultiProductResponse",
      "type": "object",
      "required": [
        "customer_id",
