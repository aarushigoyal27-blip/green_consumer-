      "indicative_criteria": "Owns a petrol/diesel car, or has regular fuel spend (not a credit decision)",
      "sustainability_metric": "kg CO2e avoided/yr",
      "credit_product": true,
      "applicable_exclusions": [
        "EXC_AGE_RESTRICTION",
        "EXC_ALREADY_EV_OWNER",
        "EXC_ARREARS_OR_DEFAULT",
        "EXC_COMPLIANCE_HOLD",
        "EXC_DUPLICATE_OFFER",
        "EXC_INACTIVE_ACCOUNT",
        "EXC_NO_VEHICLE",
        "EXC_OPT_OUT",
        "EXC_REGIONAL_RESTRICTION"
      ],
      "carbon_method": "docs/carbon_methodology.md (factors: config/emission_factors.csv)"
    },
    "GP02": {
      "product_code": "GP02",
      "opportunity_key": "GREEN_HOME",
      "product_name": "Green Home Loan",
      "intended_use": "Insulation, glazing, heat pump, smart controls. Excludes solar",
      "indicative_criteria": "Home owner (not a credit decision)",
      "sustainability_metric": "kWh saved/yr, kg CO2e/yr",
      "credit_product": true,
      "applicable_exclusions": [
        "EXC_AGE_RESTRICTION",
        "EXC_ARREARS_OR_DEFAULT",
        "EXC_COMPLIANCE_HOLD",
        "EXC_DUPLICATE_OFFER",
        "EXC_INACTIVE_ACCOUNT",
        "EXC_NOT_HOMEOWNER",
        "EXC_OPT_OUT",
        "EXC_PROPERTY_MAX_EFFICIENCY",
