{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "megathon-product-eligibility",
  "contract_name": "Megathon PS1 Product Targeting and Exclusion Contract",
  "version": "2.1.0",
  "status": "FROZEN",
  "changelog": [
    "2.1.0: account_status gains FROZEN (inactive -> EXC_INACTIVE_ACCOUNT); data used FROZEN but the engine and contract did not list it",
    "2.1.0: delinquency 30_DAYS/60_DAYS/90_DAYS now trigger EXC_ARREARS_OR_DEFAULT (previously only ARREARS/DEFAULT)",
    "2.1.0: vehicle_fuel_type input accepts any case plus aliases ELECTRIC/BEV -> ev; output stays lowercase petrol/diesel/hybrid/ev",
    "2.1.0: unknown categorical values now raise UnknownVocabularyError instead of passing silently; vulnerability read from vulnerability_flag only",
    "2.0.0: product numbering aligned to PS1 spec Section 2 (GP01 EV, GP02 Green Home, GP03 Solar, GP04 Paperless)",
    "2.0.0: INSUFFICIENT_DATA status + missing_fields; EXC_MISSING_DATA removed (missing data is not an exclusion)",
    "2.0.0: added EXC_PROPERTY_MAX_EFFICIENCY, EXC_PROPERTY_TYPE_INELIGIBLE, EXC_ALREADY_SOLAR_INSTALLED, EXC_NO_VEHICLE, EXC_NO_DIGITAL_CHANNEL",
    "2.0.0: EXC_LOW_CREDIT_SCORE -> EXC_ARREARS_OR_DEFAULT (no numeric credit score); EXC_OUTSIDE_FEATURE_WINDOW removed (data-pipeline filter)",
    "2.0.0: is_eligible -> targetable (targeting is not financial eligibility); requires_human_review for vulnerability",
    "2.0.0: emission factors removed (single source: config/emission_factors.csv); PS2 fields property_value/indicative_uplift removed",
    "2.0.0: inputs added: has_ice_vehicle, vehicle_fuel_type, annual_mileage_km (km), paper_statements_per_year, vulnerability_flag; credit_score removed"
  ],
  "metadata": {
    "platform": "Green Customer Insights Platform",
    "hackathon": "Megathon X: Singularity",
    "problem_statement": "PS1: Green Customer Insights Platform",
    "institution": "Lloyds Banking Group",
    "cutoff_date": "2026-06-30",
    "feature_window": {
      "start": "2026-01-01",
      "end": "2026-06-30"
    },
    "outcome_window": {
      "start": "2026-07-01",
      "end": "2026-12-31"
    },
    "generated_by": "scripts/build_contract.py"
  },
  "product_catalogue": {
