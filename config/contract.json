      ],
      "carbon_method": "docs/carbon_methodology.md (factors: config/emission_factors.csv)"
    },
    "GP03": {
      "product_code": "GP03",
      "opportunity_key": "SOLAR_FINANCE",
      "product_name": "Solar Finance",
      "intended_use": "Rooftop solar (with or without battery) only",
      "indicative_criteria": "Home owner, house (not flat), no existing solar (not a credit decision)",
      "sustainability_metric": "kWh generated/yr, kg CO2e/yr",
      "credit_product": true,
      "applicable_exclusions": [
        "EXC_AGE_RESTRICTION",
        "EXC_ALREADY_SOLAR_INSTALLED",
        "EXC_ARREARS_OR_DEFAULT",
        "EXC_COMPLIANCE_HOLD",
