{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "megathon-product-eligibility-v1",
  "contract_name": "Megathon Product Eligibility and Exclusion Pipeline Contract",
  "version": "1.0.0",
  "status": "FROZEN",
  "description": "Machine-readable single source of truth for observation windows, product catalogue GP01-GP04, 12 standardized exclusion reason codes, customer input schema, and grounded output payload contracts.",
  "metadata": {
    "platform": "Green Customer Insights Platform",
    "hackathon": "Megathon X: Singularity",
    "problem_statement": "PS1: Green Customer Insights Platform",
    "institution": "Lloyds Banking Group",
    "cutoff_date": "2026-06-30",
    "feature_window": {
      "start": "2026-01-01",
      "end": "2026-06-30",
      "duration_days": 181,
      "description": "Historical feature observation window for Customer 360 and behavioral aggregations. Disjoint from outcome window."
    },
    "outcome_window": {
      "start": "2026-07-01",
      "end": "2026-12-31",
      "duration_days": 184,
      "description": "Campaign take-up and ground truth conversion evaluation window. Disjoint from feature window."
    }
  },
  "product_catalogue": {
    "GP01": {
      "product_code": "GP01",
      "opportunity_key": "GREEN_HOME",
      "product_name": "Green Home Retrofit Loan",
      "category": "Home Energy Efficiency",
      "target_persona": "Homeowners in energy-inefficient properties (EPC D-G) with high heating and utility costs",
      "description": "Efficiency retrofits (insulation, heat pumps, double glazing) targeted at residential homeowners only.",
      "eligibility_rules": {
        "homeowner_required": true,
        "allowed_homeowner_statuses": ["OWNER", "OWNER_OCCUPIER", "MORTGAGED"],
        "disallowed_homeowner_statuses": ["TENANT", "LODGER", "COUNCIL_TENANT", "UNKNOWN"],
        "max_epc_rating": ["C", "D", "E", "F", "G"],
        "disallowed_epc_ratings": ["A", "B"],
        "credit_check_required": true
      },
      "applicable_exclusions": [
        "EXC_NOT_HOMEOWNER",
        "EXC_LOW_CREDIT_SCORE",
        "EXC_OUTSIDE_FEATURE_WINDOW",
        "EXC_AGE_RESTRICTION",
        "EXC_DUPLICATE_OFFER",
        "EXC_INACTIVE_ACCOUNT",
        "EXC_OPT_OUT",
        "EXC_MISSING_DATA",
        "EXC_COMPLIANCE_HOLD",
        "EXC_REGIONAL_RESTRICTION"
      ],
      "carbon_accounting": {
        "primary_fuel": "Natural Gas",
        "emission_factor_kg_co2e_per_kwh": 0.18231,
        "standard_method": "GHG Protocol project emissions accounting"
      }
    },
    "GP02": {
      "product_code": "GP02",
      "opportunity_key": "SOLAR_FINANCE",
      "product_name": "Solar PV & Battery Storage Finance",
      "category": "Renewable Electricity",
      "target_persona": "Homeowners with high daytime electricity consumption and independent roof rights",
      "description": "Solar panel and domestic battery installations targeted at residential homeowners only.",
      "eligibility_rules": {
        "homeowner_required": true,
        "allowed_homeowner_statuses": ["OWNER", "OWNER_OCCUPIER", "MORTGAGED"],
        "disallowed_homeowner_statuses": ["TENANT", "LODGER", "COUNCIL_TENANT", "UNKNOWN"],
        "allowed_property_types": ["DETACHED", "SEMI_DETACHED", "TERRACED", "BUNGALOW"],
        "disallowed_property_types": ["FLAT", "APARTMENT", "MAISONETTE_SHARED", "COMMUNAL"],
        "requires_solar_uninstalled": true,
        "credit_check_required": true
      },
      "applicable_exclusions": [
        "EXC_NOT_HOMEOWNER",
        "EXC_LOW_CREDIT_SCORE",
        "EXC_OUTSIDE_FEATURE_WINDOW",
        "EXC_AGE_RESTRICTION",
        "EXC_DUPLICATE_OFFER",
        "EXC_INACTIVE_ACCOUNT",
        "EXC_OPT_OUT",
        "EXC_MISSING_DATA",
        "EXC_COMPLIANCE_HOLD",
        "EXC_REGIONAL_RESTRICTION"
      ],
      "carbon_accounting": {
        "primary_fuel": "Grid Electricity",
        "generation_factor_kg_co2e_per_kwh": 0.13096,
        "td_loss_factor_kg_co2e_per_kwh": 0.01299,
        "net_displaced_factor_kg_co2e_per_kwh": 0.14395,
        "standard_method": "GHG Protocol project emissions accounting"
      }
    },
    "GP03": {
      "product_code": "GP03",
      "opportunity_key": "EV_FINANCE",
      "product_name": "Clean Transport & EV Finance",
      "category": "Electric Vehicles",
      "target_persona": "Regular fossil fuel commuters with high fuel spend and existing ICE vehicle ownership",
      "description": "Electric vehicle financing and leasing targeted at non-EV owners only.",
      "eligibility_rules": {
        "homeowner_required": false,
        "requires_vehicle_driver": true,
        "requires_non_ev_owner": true,
        "min_annual_fuel_spend_gbp": 720.0,
        "credit_check_required": true
      },
      "applicable_exclusions": [
        "EXC_ALREADY_EV_OWNER",
        "EXC_LOW_CREDIT_SCORE",
        "EXC_OUTSIDE_FEATURE_WINDOW",
